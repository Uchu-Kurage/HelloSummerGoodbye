[gd_resource type="Resource" script_class="DayData" load_steps=15 format=3]

[ext_resource type="Script" path="res://data/item_data.gd" id="item_script"]
[ext_resource type="Resource" path="res://data/items/senko_hanabi.tres" id="item_base"]
[ext_resource type="Script" path="res://data/day_data.gd" id="day_script"]
[ext_resource type="Script" path="res://data/day_variant.gd" id="v_script"]
[ext_resource type="Script" path="res://data/flag_condition.gd" id="c_script"]
[ext_resource type="Resource" path="res://data/items/bug_cage.tres" id="item_takeru"]
[ext_resource type="Resource" path="res://data/items/sakura_shell.tres" id="item_n_sakura_shell"]
[ext_resource type="Resource" path="res://data/items/ogara_ember.tres" id="item_kk"]

[sub_resource type="Resource" id="cond_takeru"]
script = ExtResource("c_script")
require_all = Array[StringName]([&"route_takeru"])

[sub_resource type="Resource" id="var_takeru"]
script = ExtResource("v_script")
condition = SubResource("cond_takeru")
scene_path = "res://days/variants/day_06_takeru.tscn"
items = Array[ExtResource("item_script")]([ExtResource("item_takeru")])
time_keys = Array[Vector2]([Vector2(0, -0.15), Vector2(0.6, 0), Vector2(1, 0.25)])

[sub_resource type="Resource" id="cond_natsumi"]
script = ExtResource("c_script")
require_all = Array[StringName]([&"route_natsumi"])

[sub_resource type="Resource" id="var_natsumi"]
script = ExtResource("v_script")
condition = SubResource("cond_natsumi")
scene_path = "res://days/variants/day_06_natsumi.tscn"
items = Array[ExtResource("item_script")]([ExtResource("item_n_sakura_shell")])
time_keys = Array[Vector2]([Vector2(0, 0.25), Vector2(1, 0.6)])

[sub_resource type="Resource" id="cond_kk"]
script = ExtResource("c_script")
require_all = Array[StringName]([&"route_kamikakushi"])

[sub_resource type="Resource" id="var_kk"]
script = ExtResource("v_script")
condition = SubResource("cond_kk")
scene_path = "res://days/variants/day_06_kamikakushi.tscn"
items = Array[ExtResource("item_script")]([ExtResource("item_kk")])
time_keys = Array[Vector2]([Vector2(0, 0.6), Vector2(1, 1)])

[resource]
script = ExtResource("day_script")
day_number = 6
month = 8
day = 13
title = "お盆（迎え火）"
scene_path = "res://days/variants/day_06_normal.tscn"
items = Array[ExtResource("item_script")]([ExtResource("item_base")])
variants = Array[ExtResource("v_script")]([SubResource("var_takeru"), SubResource("var_natsumi"), SubResource("var_kk")])
time_keys = Array[Vector2]([Vector2(0, 0.6), Vector2(1, 1)])
