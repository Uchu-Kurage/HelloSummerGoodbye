[gd_resource type="Resource" script_class="ItemData" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/item_data.gd" id="1"]
[ext_resource type="Texture2D" path="res://data/items/icons/rusty_bell.png" id="icon"]
[ext_resource type="Script" path="res://data/flag_condition.gd" id="c"]

[sub_resource type="Resource" id="alt"]
script = ExtResource("c")
require_all = Array[StringName]([&"bell_rang"])

[resource]
script = ExtResource("1")
id = &"rusty_bell"
display_name = "さびた鈴"
description = "ふっても ならない。"
icon = ExtResource("icon")
day_number = 1
placeholder_color = Color(0.66, 0.54, 0.31, 1)
collect_flag = &"rusty_bell_found"
alt_if = SubResource("alt")
alt_description = "ときどき、かってに なる。"
