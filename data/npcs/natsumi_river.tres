[ext_resource type="Texture2D" path="res://world/scenery/painted/npc_natsumi.png" id="sprite"]

[resource]
script = ExtResource("1")
id = &"natsumi_river"
display_name = "なつみ"
lines = Array[String](["きょうは かわを かくの。", "きみも かく？", "はい、かみ。", "@game sketch", "みせて。", "@choice みせる:show | かくす:hide", "#show", "@heart", "……いいね。", "かわの おと、きこえそう。", "@goto end", "#hide", "えー。……ちょっとだけ。", "……いいね。", "#end", "@give river_sketch"])
repeat_lines = Array[String](["また かきに こようね。"])
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.910, 0.655, 0.627, 1)
height = 148.0
skin_color = Color(0.922, 0.765, 0.627, 1)
hair_color = Color(0.227, 0.180, 0.149, 1)
shirt_color = Color(0.910, 0.655, 0.627, 1)
pants_color = Color(0.949, 0.902, 0.816, 1)
hair_full = true
