[resource]
script = ExtResource("1")
id = &"fox_shrine"
display_name = "おめんの子"
lines = Array[String](["……きてくれたんだ。", "@event unmask", "ずっと まってたんだ。", "ともだちが、むかえに くるの。", "……ここに、のこる？", "@choice のこる:stay | かえる:go", "#stay", "……ほんと？", "……うれしい。", "それだけで、いいや。", "でも、だめ。", "きみには まってる人が いる。", "@goto gift", "#go", "……うん。", "そうだよね。", "ちょっと、さみしいけど。", "#gift", "これ、あげる。", "もう かくさなくて いいから。", "@give fox_mask", "すず、ならしたら おもいだして。", "……あいつにも、よろしく。", "@event send_home", "@leave"])
auto_talk = true
sprite = ExtResource("sprite")
alt_sprite = ExtResource("alt")
alt_sprite_event = "unmask"
placeholder_color = Color(0.851, 0.439, 0.353, 1)
height = 150.0
skin_color = Color(0.886, 0.722, 0.58, 1)
hair_color = Color(0.165, 0.137, 0.125, 1)
shirt_color = Color(0.29, 0.36, 0.5, 1)
pants_color = Color(0.29, 0.36, 0.5, 1)
hair_full = true
