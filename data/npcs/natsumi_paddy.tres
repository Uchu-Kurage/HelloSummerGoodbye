[resource]
script = ExtResource("1")
id = &"natsumi_paddy"
display_name = "なつみ"
lines = Array[String](["……みないで。", "まだ かきかけ。", "@choice ごめん:sorry | なにを かいてるの？:what", "#sorry", "@heart", "……ううん。", "@goto call", "#what", "……ないしょ。", "#call", "とおくの こえ：なつみー！ ごはんよー！", "あ、いかなきゃ。", "@event natsumi_run", "@drop blue_pencil", "@leave"])
