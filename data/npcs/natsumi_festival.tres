[resource]
script = ExtResource("1")
id = &"natsumi_festival"
display_name = "なつみ"
lines = Array[String](["……へん？", "@choice にあってる:good | いつもと ちがう:diff", "#good", "@heart", "……ありがと。", "@goto go", "#diff", "……ゆかた、だもん。", "#go", "きんぎょすくい、しよ。", "@game kingyo", "@if_flag kingyo_good many", "……やぶれちゃった。", "@goto bag", "#many", "すごい。……いっぱい とれたね。", "#bag", "@if_good two", "おじさん：はい、1ぴき もってきな。", "@goto take", "#two", "おじさん：はい、2ひき もってきな。", "#take", "@give goldfish_bag"])
repeat_lines = Array[String](["きんぎょ、なまえ つけてね。"])
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.910, 0.655, 0.627, 1)
height = 148.0
skin_color = Color(0.922, 0.765, 0.627, 1)
hair_color = Color(0.227, 0.180, 0.149, 1)
shirt_color = Color(0.910, 0.655, 0.627, 1)
pants_color = Color(0.949, 0.902, 0.816, 1)
hair_full = true
