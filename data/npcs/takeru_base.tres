[gd_resource type="Resource" script_class="NpcData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/npc_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"takeru_base"
display_name = "タケル"
lines = Array[String](["おーい！ こっち こい！", "……ひみつきち。まだ つくりかけ。", "だれにも いうなよ。", "ぼく：すごい", "……おまえも つかっていいぞ。", "あめもり ふさぐぞ。てつだえ。", "いりぐちは、おれが あとで つくる。", "@game base_build", "……セミ、なきやんだな。", "ぼく：ほんとだ", "あめ やんだら、またなくよ。", "とかいって、セミいる？", "ぼく：いるけど、こんなに いない", "へー。かわいそ。", "@event rain_stop", "@give base_plaque"])
repeat_lines = Array[String](["いりぐちは、おれが あとで つくる。"])
auto_talk = true
placeholder_color = Color(0.659, 0.357, 0.271, 1)
height = 140.0
skin_color = Color(0.776, 0.557, 0.384, 1)
hair_color = Color(0.129, 0.114, 0.102, 1)
shirt_color = Color(0.914, 0.890, 0.827, 1)
pants_color = Color(0.243, 0.353, 0.478, 1)
hair_full = true
