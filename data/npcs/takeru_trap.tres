[ext_resource type="Texture2D" path="res://world/scenery/painted/npc_takeru.png" id="sprite"]

[sub_resource type="Resource" id="appear"]
script = ExtResource("2")
require_all = Array[StringName]([&"takeru_d6_go"])

[resource]
script = ExtResource("1")
id = &"takeru_trap"
display_name = "タケル"
lines = Array[String](["いた！ オスだ！ ツノでっけえ！", "おまえが とれよ。", "そーっとな。そーっと。", "@game kabuto", "@if_flag kabuto_dropped dropped", "うまいじゃん。むしとり めいじん。", "@goto after", "#dropped", "あぶねー。にげるかと おもった。", "#after", "おまえに やるよ。とかいに いないんだろ。", "@give bug_cage"])
repeat_lines = Array[String](["いた！ オスだ！ ツノでっけえ！"])
appear_if = SubResource("appear")
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.659, 0.357, 0.271, 1)
height = 154.0
skin_color = Color(0.776, 0.557, 0.384, 1)
hair_color = Color(0.129, 0.114, 0.102, 1)
shirt_color = Color(0.914, 0.890, 0.827, 1)
pants_color = Color(0.243, 0.353, 0.478, 1)
hair_full = true
