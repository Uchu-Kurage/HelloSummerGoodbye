[resource]
script = ExtResource("1")
id = &"grandpa_river"
display_name = "おじいちゃん"
lines = Array[String](["みずは つめたいぞ。", "むかしは ここで、ともだちと よく あそんだ。", "……ささぶね、つくれるか。", "ほを たてると、とおくまで いくんだ。", "@event sasabune", "（ふたりで ささぶねを ながした）"])
repeat_lines = Array[String](["……よく ながれるな。"])
appear_if = SubResource("appear")
auto_talk = true
sprite = ExtResource("sprite")
