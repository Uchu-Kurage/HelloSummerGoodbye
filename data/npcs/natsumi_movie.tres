[resource]
script = ExtResource("1")
id = &"natsumi_movie"
display_name = "なつみ"
lines = Array[String](["はじまるよ。", "となり、あいてる。", "@game movie", "……こわかった？", "@choice ちょっと:bit | ぜんぜん:no", "#bit", "@heart", "わたしも。", "……ないしょね。", "@goto end", "#no", "……うそ。", "てに ちから、はいってたよ。", "#end", "これ、あげる。うらに かいたの。", "@give movie_flyer"])
repeat_lines = Array[String](["こわかったね。"])
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.910, 0.655, 0.627, 1)
height = 148.0
skin_color = Color(0.922, 0.765, 0.627, 1)
hair_color = Color(0.227, 0.180, 0.149, 1)
shirt_color = Color(0.910, 0.655, 0.627, 1)
pants_color = Color(0.949, 0.902, 0.816, 1)
hair_full = true
