[gd_resource type="Resource" script_class="NpcData" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/npc_data.gd" id="1"]
[ext_resource type="Texture2D" path="res://world/scenery/kamikakushi/fox_child.svg" id="sprite"]
[ext_resource type="Script" path="res://data/flag_condition.gd" id="2"]

[sub_resource type="Resource" id="appear"]
script = ExtResource("2")
require_all = Array[StringName]([&"bell_rang"])
forbid_any = Array[StringName]([&"route_takeru", &"route_natsumi"])

[resource]
script = ExtResource("1")
id = &"fox_rain"
display_name = "おめんの子"
lines = Array[String](["……それ、ぼくの すず。", "ずっと さがしてた。", "……あそぼ。", "@choice あそぶ:play | かえる:home", "#play", "@flag route_kamikakushi", "かくれんぼ。きみが おに。", "@game kakurenbo", "みつかっちゃった。", "すず、もってて。", "ならしたら、また くる。", "@event rain_stop", "@leave", "@end", "#home", "……そっか。", "@event rain_stop", "@leave"])
appear_if = SubResource("appear")
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.851, 0.439, 0.353, 1)
height = 150.0
skin_color = Color(0.886, 0.722, 0.58, 1)
hair_color = Color(0.165, 0.137, 0.125, 1)
shirt_color = Color(0.29, 0.36, 0.5, 1)
pants_color = Color(0.29, 0.36, 0.5, 1)
hair_full = true
