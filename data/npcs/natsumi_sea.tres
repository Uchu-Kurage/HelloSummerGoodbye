[ext_resource type="Texture2D" path="res://world/scenery/painted/npc_natsumi.png" id="sprite"]

[resource]
script = ExtResource("1")
id = &"natsumi_sea"
display_name = "なつみ"
lines = Array[String](["おぼんは うみに はいっちゃ だめなんだよ。", "@choice どうして？:why | ちょっとだけ:just", "#why", "@heart", "つれていかれるから、だって。", "おばあちゃんが いってた。", "@goto shell", "#just", "……だめ。", "つれていかれるよ。", "#shell", "かいがら、さがそ。", "@game kaigara", "@if_flag kaigara_good found", "……あった。さくらがい。", "@goto half", "#found", "それ、さくらがい！ ……きれい。", "#half", "はんぶんこ しよ。", "@give sakura_shell"])
repeat_lines = Array[String](["なみの おと、ずっと きいてられるね。"])
auto_talk = true
sprite = ExtResource("sprite")
placeholder_color = Color(0.910, 0.655, 0.627, 1)
height = 148.0
skin_color = Color(0.922, 0.765, 0.627, 1)
hair_color = Color(0.227, 0.180, 0.149, 1)
shirt_color = Color(0.910, 0.655, 0.627, 1)
pants_color = Color(0.949, 0.902, 0.816, 1)
hair_full = true
